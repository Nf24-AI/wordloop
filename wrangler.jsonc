{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wordloop-staging",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-12",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 17 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "PUSH_DB",
      "database_name": "wordloop-push-staging",
      "database_id": "65707638-4977-4bde-b480-974fa12c340b"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "WORDLOOP_ENV": "staging"
  }
}
