{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wordloop-staging",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-12",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // #70: every request reaches the Worker first so the optional PIN gate (AUTH_MODE="pin") can protect pages and assets too.
    // With AUTH_MODE unset the Worker hands non-API paths straight to the assets, exactly as before.
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "PUSH_DB",
      "database_name": "wordloop-push-staging",
      "database_id": "65707638-4977-4bde-b480-974fa12c340b"
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "WORDLOOP_ENV": "staging"
  },
  "ratelimits": [
    {
      "name": "PUSH_LIMIT",
      "namespace_id": "69452",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
